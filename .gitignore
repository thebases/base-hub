# app/backend/frontend is a static, no-bundler SPA — its vendor/ assets
# (Owl, base-ui) are the actual runtime dependency, not a build artifact, so
# they must be committed despite the blanket "vendor" ignore above.
!app/backend/frontend/vendor/
!app/backend/frontend/vendor/**
version.json
**/*/version.json
# app/backend/frontend is embedded straight from source (no build step), so
# unlike the other version.json files (which are CI build artifacts), this
# one must be committed or //go:embed in main_embed.go has nothing to match.
!app/backend/frontend/version.json
.agents
.claude
