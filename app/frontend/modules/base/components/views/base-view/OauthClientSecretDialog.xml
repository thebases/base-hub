<templates xml:space="preserve">
  <t t-name="OauthClientSecretDialog">
    <Dialog open="props.state.open" onOpenChange="(open) => props.onOpenChange(open)">
      <DialogContent>
        <DialogHeader>
          <t t-if="result and result.alreadyExists">
            <DialogTitle><t t-esc="t('OAuth Client Already Exists')"/></DialogTitle>
            <p class="mb-0 text-body-secondary">
              <t t-esc="t('{name} already exists. Generate a new secret if the original one is lost.', { name: props.state.subjectName || t('This OAuth client') })"/>
            </p>
          </t>
          <t t-else="">
            <DialogTitle><t t-esc="t('OAuth Client Created')"/></DialogTitle>
            <p class="mb-0 text-body-secondary">
              <t t-esc="t('Copy this secret now for {name} — it will never be shown again.', { name: props.state.subjectName || t('this OAuth client') })"/>
            </p>
          </t>
        </DialogHeader>
        <t t-if="result">
          <div class="d-flex flex-column gap-3">
            <Field>
              <FieldLabel><t t-esc="t('Client ID')"/></FieldLabel>
              <div class="input-group">
                <code class="basehub-oauth-code" t-esc="result.clientId"/>
                <Button variant="'outline'" size="'sm'" aria-label="t('Copy Client ID')"
                        onClick="() => this.copy(result.clientId)">
                  <Icon name="'copy'"/>
                </Button>
              </div>
            </Field>
            <t t-if="result.clientSecret">
              <Field>
                <FieldLabel><t t-esc="t('Client Secret')"/></FieldLabel>
                <div class="input-group">
                  <code class="basehub-oauth-code" t-esc="result.clientSecret"/>
                  <Button variant="'outline'" size="'sm'" aria-label="t('Copy Client Secret')"
                          onClick="() => this.copy(result.clientSecret)">
                    <Icon name="'copy'"/>
                  </Button>
                </div>
              </Field>
            </t>
          </div>
        </t>
        <DialogFooter>
          <Button variant="'default'" onClick="() => this.done()"><t t-esc="t('Done')"/></Button>
        </DialogFooter>
      </DialogContent>
    </Dialog>
  </t>
</templates>
