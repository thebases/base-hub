<templates xml:space="preserve">
  <t t-name="UserSecurityPasswordDialog">
    <Dialog open="props.state.open" onOpenChange="(open) => this.onOpenChange(open)">
      <DialogContent>
        <DialogHeader>
          <DialogTitle><t t-esc="t('Change Password')"/></DialogTitle>
          <p class="mb-0 text-body-secondary">
            <t t-out="tHtml('Set a new password for &lt;strong&gt;{name}&lt;/strong&gt;.', { name: props.state.userName || t('this user') })"/>
          </p>
        </DialogHeader>
        <div class="d-flex flex-column gap-2">
          <t t-if="state.error">
            <Alert variant="'danger'" t-esc="state.error"/>
          </t>
          <Field>
            <FieldLabel for="'user-security-new-password'"><t t-esc="t('New password')"/></FieldLabel>
            <div class="input-group">
              <Input type="state.showPassword ? 'text' : 'password'"
                     value="state.password" disabled="state.submitting"
                     placeholder="t('Enter a new password')" onInput="(value) => this.onPasswordInput(value)"/>
              <Button variant="'outline'" type="'button'" disabled="state.submitting"
                      onClick="() => this.togglePasswordVisibility()">
                <t t-esc="state.showPassword ? t('Hide') : t('Show')"/>
              </Button>
            </div>
          </Field>
        </div>
        <DialogFooter>
          <Button variant="'outline'" disabled="state.submitting" onClick="() => this.cancel()" label="t('Cancel')"/>
          <Button variant="'default'" disabled="state.submitting" onClick="() => this.confirm()">
            <t t-if="state.submitting" t-esc="t('Saving...')"/>
            <t t-else="" t-esc="t('Save Password')"/>
          </Button>
        </DialogFooter>
      </DialogContent>
    </Dialog>
  </t>
</templates>
