<templates xml:space="preserve">
  <t t-name="Breadcrumbs">
    <t t-if="props.items.length > 0">
      <nav t-att-aria-label="t('Breadcrumb')" class="basehub-breadcrumbs">
        <ol class="breadcrumb mb-0">
          <t t-foreach="props.items" t-as="item" t-key="item_index">
            <li t-att-class="isLast(item_index) ? 'breadcrumb-item active' : 'breadcrumb-item'"
                t-att-aria-current="isLast(item_index) ? 'page' : undefined">
              <t t-if="isLast(item_index)">
                <t t-esc="item.label"/>
              </t>
              <t t-else="">
                <a href="#" t-on-click.prevent="() => this.onClickCrumb(item)" t-esc="item.label"/>
              </t>
            </li>
          </t>
        </ol>
      </nav>
    </t>
  </t>
</templates>
