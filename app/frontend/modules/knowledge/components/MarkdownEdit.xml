  <t t-name="MarkdownEdit">
    <div id="markdown-editor" class="basehub-md-editor">
      <TextEditor className="'basehub-md-editor-textarea'"
                  content="state.html"
                  placeholder="t('Write markdown…')"
                  collaborative="collaborative"
                  room="room"
                  user="collaborationUser"
                  onChange="handleTextEditorChange"/>
