msgstr "Đổi tên tệp markdown"

msgid "Enter the new markdown file path."
msgstr "Nhập đường dẫn tệp markdown mới."

msgid "docs/example.md"
msgstr "docs/example.md"

msgid "Share markdown document"
msgstr "Chia sẻ tài liệu markdown"

