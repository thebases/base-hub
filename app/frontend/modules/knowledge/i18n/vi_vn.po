msgid "Create markdown file"
msgstr "Tạo tệp markdown"

msgid "Enter the menu label, file name, and an optional folder under the writable public docs. Base documents are read-only and cannot be chosen."
msgstr "Nhập nhãn menu, tên tệp và thư mục tùy chọn trong tài liệu công khai có thể ghi. Tài liệu Base ở chế độ chỉ đọc và không thể chọn."

msgid "Menu label"
msgstr "Nhãn menu"

msgid "File name, e.g. api-overview.md"
msgstr "Tên tệp, ví dụ api-overview.md"

msgid "Folder in public docs, e.g. docs/api (leave blank for the public root)"
msgstr "Thư mục trong tài liệu công khai, ví dụ docs/api (để trống cho thư mục gốc công khai)"

msgid "Cancel"
msgstr "Hủy"

