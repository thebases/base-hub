<?xml version="1.0" encoding="utf-8"?>
<data noupdate="1">
    <record id="view_sys_credential_list" model="ui.view">
      <field name="name">sys.credential.list</field>
      <field name="model">sys.credential</field>
      <field name="type">list</field>
      <field name="arch" type="xml">
        <list string="Credentials" sample="1">
          <field name="name"/>
          <field name="credential_type"/>
          <field name="auth_url" optional="show"/>
          <field name="expired_time" optional="show"/>
          <field name="last_login_status" optional="show"/>
          <field name="active"/>
        </list>
      </field>
    </record>
    <record id="view_sys_credential_form" model="ui.view">
      <field name="name">sys.credential.form</field>
      <field name="model">sys.credential</field>
      <field name="type">form</field>
      <field name="arch" type="xml">
        <form string="Credential">
          <sheet>
            <div class="d-flex align-items-start gap-4">
              <main class="d-flex flex-fill flex-column gap-2">
                <h1 class="d-flex align-items-center gap-3">
                  <field name="name" nolabel="1" placeholder="Credential reference name"/>
                  <button
                    string="Try"
                    type="object"
                    name="login"
                    class="btn-secondary"
                    icon="fa-refresh"
                    invisible="credential_type != 'oidc_client' and credential_type != 'oidc_password'"
                  />
                </h1>
                <div class="small text-muted">
                  Used by workflow action params as @cred:&lt;name&gt;. Secret fields are
                  encrypted at rest and never returned once saved.
                </div>
              </main>
            </div>
            <group>
              <group string="Connection">
                <field name="credential_type"/>
                <field name="description"/>
                <field name="auth_url"/>
                <field name="active"/>
              </group>
              <group string="RBAC / OIDC Password">
                <field name="user_name"/>
                <field name="password" widget="password"/>
              </group>
              <group string="OIDC Client">
                <field name="client_id"/>
                <field name="client_secret" widget="password"/>
                <field name="scope"/>
              </group>
              <group string="Token State">
                <field name="access_token" widget="password"/>
                <field name="refresh_token" widget="password"/>
                <field name="expired_time"/>
                <field name="refresh_before_seconds"/>
              </group>
              <group string="Last Attempt">
                <field name="last_login_status"/>
                <field name="last_login_error"/>
                <field name="last_login_at"/>
              </group>
            </group>
          </sheet>
        </form>
      </field>
    </record>
</data>
