<?xml version="1.0" encoding="utf-8"?>
<data noupdate="1">
    <record id="view_helpdesk_stage_list" model="ui.view">
      <field name="name">tbl.helpdesk_stage.list</field>
      <field name="model">tbl.helpdesk_stage</field>
      <field name="type">list</field>
      <field name="arch" type="xml">
        <list string="Helpdesk Stages">
          <field name="name"/>
          <field name="sequence"/>
          <field name="fold"/>
          <field name="is_closed"/>
          <field name="unattended"/>
        </list>
      </field>
    </record>
    <record id="view_helpdesk_stage_form" model="ui.view">
      <field name="name">tbl.helpdesk_stage.form</field>
      <field name="model">tbl.helpdesk_stage</field>
      <field name="type">form</field>
      <field name="arch" type="xml">
        <form string="Helpdesk Stage">
          <sheet>
            <group>
              <field name="name"/>
              <field name="sequence"/>
              <field name="fold"/>
              <field name="is_closed"/>
              <field name="unattended"/>
              <field name="team_ids"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>
    <record id="view_helpdesk_stage_search" model="ui.view">
      <field name="name">tbl.helpdesk_stage.search</field>
      <field name="model">tbl.helpdesk_stage</field>
      <field name="type">search</field>
      <field name="arch" type="xml">
        <search string="Helpdesk Stages">
          <field name="name"/>
        </search>
      </field>
    </record>
</data>
