<?xml version="1.0" encoding="utf-8"?>
<data noupdate="1">
    <record id="view_helpdesk_tag_list" model="ui.view">
      <field name="name">tbl.helpdesk_tag.list</field>
      <field name="model">tbl.helpdesk_tag</field>
      <field name="type">list</field>
      <field name="arch" type="xml">
        <list string="Helpdesk Tags">
          <field name="name"/>
          <field name="color"/>
        </list>
      </field>
    </record>
    <record id="view_helpdesk_tag_form" model="ui.view">
      <field name="name">tbl.helpdesk_tag.form</field>
      <field name="model">tbl.helpdesk_tag</field>
      <field name="type">form</field>
      <field name="arch" type="xml">
        <form string="Helpdesk Tag">
          <sheet>
            <group>
              <field name="name"/>
              <field name="color"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>
    <record id="view_helpdesk_tag_search" model="ui.view">
      <field name="name">tbl.helpdesk_tag.search</field>
      <field name="model">tbl.helpdesk_tag</field>
      <field name="type">search</field>
      <field name="arch" type="xml">
        <search string="Helpdesk Tags">
          <field name="name"/>
        </search>
      </field>
    </record>
</data>
