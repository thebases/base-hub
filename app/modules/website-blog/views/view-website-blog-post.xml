<?xml version="1.0" encoding="utf-8"?>
<data noupdate="1">
    <record id="view_website_blog_post_list" model="ui.view">
      <field name="name">tbl.website_blog_post.list</field>
      <field name="model">tbl.website_blog_post</field>
      <field name="type">list</field>
      <field name="arch" type="xml">
        <list string="Blog Posts">
          <field name="name"/>
          <field name="blog_id"/>
          <field name="state"/>
          <field name="published_at"/>
          <field name="author_id" optional="show"/>
          <field name="tag_ids" optional="show"/>
          <field name="is_featured" optional="hide"/>
          <field name="read_minutes" optional="hide"/>
          <field name="visits" optional="show"/>
          <action>
            <button string="Publish" type="object" name="action_publish" invisible="state == 'published'"/>
            <button string="Unpublish" type="object" name="action_unpublish" invisible="state != 'published'"/>
            <button string="Archive" type="object" name="action_archive" invisible="state == 'archived'"/>
            <button string="Duplicate" type="object" name="action_duplicate"/>
          </action>
        </list>
      </field>
    </record>
    <record id="view_website_blog_post_kanban" model="ui.view">
      <field name="name">tbl.website_blog_post.kanban</field>
      <field name="model">tbl.website_blog_post</field>
      <field name="type">kanban</field>
      <field name="arch" type="xml">
        <kanban default_group_by="state">
          <templates>
            <t t-name="card">
              <div class="o_kanban_record">
                <field name="name"/>
                <field name="blog_id"/>
                <field name="author_id"/>
                <field name="published_at"/>
                <field name="tag_ids"/>
              </div>
            </t>
          </templates>
        </kanban>
      </field>
    </record>
    <record id="view_website_blog_post_form" model="ui.view">
      <field name="name">tbl.website_blog_post.form</field>
      <field name="model">tbl.website_blog_post</field>
      <field name="type">form</field>
      <field name="arch" type="xml">
        <form string="Blog Post">
          <sheet>
            <group>
              <group string="Article">
                <field name="name"/>
                <field name="subtitle"/>
                <field name="blog_id"/>
                <field name="tag_ids"/>
                <field name="author_id"/>
                <field name="author_name"/>
                <field name="cover_url" widget="image_url"/>
                <field name="is_featured"/>
                <field name="teaser"/>
              </group>
              <group string="Content">
                <widget name="blog_content_editor" field="content"/>
              </group>
              <group string="Publishing">
                <field name="state"/>
                <field name="published_at"/>
                <field name="slug"/>
                <field name="company_id" readonly="1"/>
                <field name="read_minutes" readonly="1"/>
                <field name="visits" readonly="1"/>
                <button name="action_publish" type="object" string="Publish" class="btn-primary" invisible="not id or state == 'published'"/>
                <button name="action_unpublish" type="object" string="Unpublish" invisible="state != 'published'"/>
                <button name="action_archive" type="object" string="Archive" invisible="not id or state == 'archived'"/>
                <button name="action_duplicate" type="object" string="Duplicate" invisible="not id"/>
              </group>
              <group string="SEO">
                <field name="meta_title"/>
                <field name="meta_description"/>
                <field name="meta_keywords"/>
                <field name="canonical_url"/>
                <field name="no_index"/>
              </group>
            </group>
          </sheet>
        </form>
      </field>
    </record>
    <record id="view_website_blog_post_search" model="ui.view">
      <field name="name">tbl.website_blog_post.search</field>
      <field name="model">tbl.website_blog_post</field>
      <field name="type">search</field>
      <field name="arch" type="xml">
        <search string="Blog Posts">
          <field name="name"/>
          <field name="blog_id"/>
          <field name="author_id"/>
          <field name="state"/>
          <group>
            <filter string="Blog" name="group_by_blog" domain="[]" context="{'group_by': 'blog_id'}"/>
            <filter string="Status" name="group_by_state" domain="[]" context="{'group_by': 'state'}"/>
            <filter string="Author" name="group_by_author" domain="[]" context="{'group_by': 'author_id'}"/>
          </group>
        </search>
      </field>
    </record>
</data>
