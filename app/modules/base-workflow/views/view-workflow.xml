<?xml version="1.0" encoding="utf-8"?>
<data noupdate="1">
  <record id="generateWorkflowAction" model="ui.actions.client">
    <field name="name">Generate Workflow by Script</field>
    <field name="tag">genActionFlow</field>
    <field name="target">current</field>
    <field name="sys_model">base.workflow</field>
    <field name="context" eval="{'active_model': 'active_model', 'active_id': 'active_id', 'active_ids': 'active_ids'}"/>
  </record>
  <record id="view_base_etl_flow_list" model="ui.view">
    <field name="name">base.workflow.list</field>
    <field name="model">base.workflow</field>
    <field name="type">list</field>
    <field name="arch" type="xml">
      <list string="Workflows" sample="1" multi_edit="1">
        <field name="name"/>
        <field name="topic"/>
        <field name="version"/>
        <field name="state" optional="show"/>
        <field name="published_version" optional="hide"/>
        <field name="is_active"/>
        <field name="group_id" optional="show"/>
        <field name="action_ids" optional="show"/>
        <field name="description" optional="show"/>
        <field name="created_at" optional="show"/>
        <field name="updated_at" optional="show"/>
      </list>
    </field>
  </record>
  <record id="view_base_etl_flow_form" model="ui.view">
    <field name="name">base.workflow.form</field>
    <field name="model">base.workflow</field>
    <field name="type">form</field>
    <field name="arch" type="xml">
      <form string="Workflow">
        <sheet>
          <div class="d-flex align-items-start gap-4">
            <main class="d-flex flex-fill flex-column gap-2">
              <h1>
                <field name="name" nolabel="1" placeholder="Workflow name"/>
              </h1>
              <div class="small text-muted">
                  Versioned workflow definition used by the workflow execution service and retry recovery path.
              </div>
            </main>
          </div>
          <group>
            <group string="Definition">
              <field name="name"/>
              <field name="is_active"/>
              <field name="topic"/>
              <field name="version"/>
              <field name="group_id"/>
            </group>
            <group string="Notes">
              <field name="description"/>
              <field name="audit_redact_keys"/>
            </group>
            <group string="Run Control">
              <field name="max_run_seconds"/>
              <field name="max_concurrent_runs"/>
            </group>
            <group string="Publishing">
              <field name="state" readonly="1"/>
              <field name="published_version" readonly="1"/>
              <field name="published_at" readonly="1"/>
            </group>
          </group>
          <notebook>
            <page string="Action Sequence" name="flow_definition">
              <div>
                <button name="generateWorkflowAction" type="client" string="Generate WorkFlow by Script" />
                <label string="Workflow execution order is defined by the linked base.workflow.action records and their sequence values."/>
              </div>
              <field name="action_ids"/>
            </page>
            <page string="Canvas" name="workflow_canvas">
              <div>
                <label string="Visual canvas editor for the workflow action chain. Save from inside the canvas to rebuild the action sequence and persist layout metadata."/>
              </div>
              <field name="layout" widget="workflow_canvas" nolabel="1"/>
            </page>
            <page string="Flow Map" name="flow_map">
              <div>
                <button name="writeWorkflowFlowMap" type="object" string="Generate Flow Map" />
                <label string="Generated markdown and Mermaid diagram for the current workflow action sequence."/>
              </div>
              <field name="flow_map" widget="markdown" readonly="1"/>
            </page>

          </notebook>
        </sheet>
      </form>
    </field>
  </record>
  <record id="view_base_etl_flow_search" model="ui.view">
    <field name="name">base.workflow.search</field>
    <field name="model">base.workflow</field>
    <field name="type">search</field>
    <field name="arch" type="xml">
      <search string="Workflow">
        <field name="name"/>
        <field name="topic"/>
        <field name="version"/>
        <field name="group_id"/>
        <field name="description"/>
        <field name="created_at"/>
        <field name="updated_at"/>
        <filter string="Active" name="is_active_true" domain="[('is_active', '=', True)]"/>
        <filter string="Inactive" name="is_active_false" domain="[('is_active', '=', False)]"/>
        <filter string="Draft" name="state_draft" domain="[('state', '=', 'draft')]"/>
        <group>
          <filter string="Name" name="group_by_name" domain="[]" context="{'group_by': 'name'}"/>
          <filter string="Topic" name="group_by_topic" domain="[]" context="{'group_by': 'topic'}"/>
          <filter string="Version" name="group_by_version" domain="[]" context="{'group_by': 'version'}"/>
          <filter string="Group" name="group_by_group_id" domain="[]" context="{'group_by': 'group_id'}"/>
          <filter string="Status" name="group_by_is_active" domain="[]" context="{'group_by': 'is_active'}"/>
        </group>
      </search>
    </field>
  </record>
</data>
