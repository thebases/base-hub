<?xml version="1.0" encoding="utf-8"?>
<data noupdate="1">
  <record id="view_base_workflow_credential_list" model="ui.view">
    <field name="name">base.workflow.credential.list</field>
    <field name="model">base.workflow.credential</field>
    <field name="type">list</field>
    <field name="arch" type="xml">
      <list string="Workflow Credentials" sample="1">
        <field name="name"/>
        <field name="credential_type"/>
        <field name="workflow_id"/>
        <field name="company_id" optional="show"/>
        <field name="description" optional="show"/>
      </list>
    </field>
  </record>
  <record id="view_base_workflow_credential_form" model="ui.view">
    <field name="name">base.workflow.credential.form</field>
    <field name="model">base.workflow.credential</field>
    <field name="type">form</field>
    <field name="arch" type="xml">
      <form string="Workflow Credential">
        <sheet>
          <h1>
            <field name="name" nolabel="1" placeholder="Credential reference name"/>
          </h1>
          <group>
            <group string="Definition">
              <field name="credential_type"/>
              <field name="workflow_id"/>
              <field name="company_id"/>
            </group>
            <group string="Notes">
              <field name="description"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>
  <record id="view_base_workflow_credential_search" model="ui.view">
    <field name="name">base.workflow.credential.search</field>
    <field name="model">base.workflow.credential</field>
    <field name="type">search</field>
    <field name="arch" type="xml">
      <search string="Workflow Credentials">
        <field name="name"/>
        <field name="credential_type"/>
        <field name="workflow_id"/>
        <group>
          <filter string="Credential Type" name="group_by_credential_type" domain="[]" context="{'group_by': 'credential_type'}"/>
          <filter string="Workflow" name="group_by_workflow_id" domain="[]" context="{'group_by': 'workflow_id'}"/>
        </group>
      </search>
    </field>
  </record>
</data>
