<?xml version="1.0" encoding="utf-8"?>
<data noupdate="1">
    <record id="view_project_update_list" model="ui.view">
      <field name="name">tbl.project_update.list</field>
      <field name="model">tbl.project_update</field>
      <field name="type">list</field>
      <field name="arch" type="xml">
        <list string="Project Updates">
          <field name="date"/>
          <field name="name"/>
          <field name="project_id"/>
          <field name="status"/>
          <field name="progress"/>
          <field name="user_id"/>
        </list>
      </field>
    </record>
    <record id="view_project_update_form" model="ui.view">
      <field name="name">tbl.project_update.form</field>
      <field name="model">tbl.project_update</field>
      <field name="type">form</field>
      <field name="use_chatter" eval="True"/>
      <field name="arch" type="xml">
        <form string="Project Updates">
          <sheet>
            <group>
              <group>
                <field name="name"/>
                <field name="project_id"/>
                <field name="status"/>
                <field name="progress"/>
              </group>
              <group>
                <field name="user_id"/>
                <field name="date"/>
                <field name="description"/>
              </group>
            </group>
          </sheet>
        </form>
      </field>
    </record>
    <record id="view_project_update_search" model="ui.view">
      <field name="name">tbl.project_update.search</field>
      <field name="model">tbl.project_update</field>
      <field name="type">search</field>
      <field name="arch" type="xml">
        <search string="Project Updates">
          <field name="name"/>
          <field name="project_id"/>
          <field name="status"/>
          <field name="user_id"/>
          <group>
            <filter string="Project" name="group_by_project_id" domain="[]" context="{'group_by': 'project_id'}"/>
            <filter string="Status" name="group_by_status" domain="[]" context="{'group_by': 'status'}"/>
          </group>
        </search>
      </field>
    </record>
</data>
