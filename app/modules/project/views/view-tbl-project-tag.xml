      <field name="name">tbl.project_tag.list</field>
      <field name="model">tbl.project_tag</field>
      <field name="type">list</field>
      <field name="arch" type="xml">
        <list string="Project Tags">
          <field name="name"/>
          <field name="color"/>
        </list>
      </field>
    </record>
    <record id="view_project_tag_form" model="ui.view">
      <field name="name">tbl.project_tag.form</field>
      <field name="model">tbl.project_tag</field>
      <field name="type">form</field>
