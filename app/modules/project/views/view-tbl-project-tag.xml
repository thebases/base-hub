        <form string="Project Tags">
          <sheet>
            <group>
              <field name="name"/>
              <field name="color"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>
    <record id="view_project_tag_search" model="ui.view">
      <field name="name">tbl.project_tag.search</field>
      <field name="model">tbl.project_tag</field>
      <field name="type">search</field>
      <field name="arch" type="xml">
        <search string="Project Tags">
          <field name="name"/>
        </search>
      </field>
    </record>
</data>
