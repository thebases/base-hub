<?xml version="1.0" encoding="utf-8"?>
<data noupdate="1">
    <record id="view_project_task_list" model="ui.view">
      <field name="name">tbl.project_task.list</field>
      <field name="model">tbl.project_task</field>
      <field name="type">list</field>
      <field name="arch" type="xml">
        <list string="Tasks">
          <dashboard>
            <stat string="Open" icon="check-square" color="primary" domain="[('is_closed', '=', False)]" total_domain="[]"/>
            <stat string="Blocked" icon="ban" color="danger" domain="[('kanban_state', '=', 'blocked')]"/>
            <stat string="Important" icon="star" color="warning" domain="[('priority', '=', '1'), ('is_closed', '=', False)]"/>
          </dashboard>
          <field name="priority"/>
          <field name="name"/>
          <field name="project_id"/>
          <field name="stage_id"/>
          <field name="user_ids"/>
          <field name="milestone_id"/>
          <field name="date_deadline"/>
          <field name="date_done"/>
          <field name="is_on_time"/>
          <field name="kanban_state"/>
          <field name="tag_ids"/>
        </list>
      </field>
    </record>
    <record id="view_project_task_form" model="ui.view">
      <field name="name">tbl.project_task.form</field>
      <field name="model">tbl.project_task</field>
      <field name="type">form</field>
      <field name="use_chatter" eval="True"/>
      <field name="arch" type="xml">
        <form string="Tasks">
          <sheet>
            <group>
              <group>
                <field name="name"/>
                <field name="project_id"/>
                <field name="milestone_id"/>
                <field name="parent_id"/>
                <field name="stage_id"/>
                <field name="priority"/>
                <field name="kanban_state"/>
              </group>
              <group>
                <field name="date_start"/>
                <field name="date_deadline"/>
                <field name="date_assign"/>
                <field name="date_done"/>
                <field name="is_on_time"/>
                <field name="date_last_stage_update"/>
                <field name="allocated_hours" required="0"/>
              </group>
            </group>
            <notebook>
              <page string="Description" name="description">
                <field name="description" nolabel="1" widget="text_editor"/>
              </page>
              <page string="Details" name="details">
                <group>
                  <group>
                    <field name="tag_ids"/>
                    <field name="user_ids"/>
                    <field name="role_ids"/>
                    <field name="partner_id"/>
                    <field name="partner_phone"/>
                    <field name="email_from"/>
                    <field name="email_cc"/>
                  </group>
                  <group>
                    <field name="is_closed"/>
                    <field name="display_in_project"/>
                    <field name="subtask_count"/>
                    <field name="closed_subtask_count"/>
                    <field name="recurring_task"/>
                    <field name="repeat_interval" invisible="not recurring_task" required="0"/>
                    <field name="repeat_unit" invisible="not recurring_task" required="0"/>
                    <field name="repeat_type" invisible="not recurring_task" required="0"/>
                    <field name="repeat_until" invisible="not recurring_task or repeat_type != 'until'" required="0"/>
                    <field name="is_template"/>
                    <field name="depend_on_ids"/>
                    <field name="dependent_ids"/>
                  </group>
                </group>
              </page>
            </notebook>
          </sheet>
        </form>
      </field>
    </record>
    <record id="view_project_task_search" model="ui.view">
      <field name="name">tbl.project_task.search</field>
      <field name="model">tbl.project_task</field>
      <field name="type">search</field>
      <field name="arch" type="xml">
        <search string="Tasks">
          <field name="name"/>
          <field name="project_id"/>
          <field name="stage_id"/>
          <field name="user_ids"/>
          <field name="tag_ids"/>
          <field name="partner_id"/>
          <field name="milestone_id"/>
          <filter string="Open" name="open" domain="[('is_closed', '=', False)]"/>
          <filter string="Closed" name="closed" domain="[('is_closed', '=', True)]"/>
          <filter string="Blocked" name="blocked" domain="[('kanban_state', '=', 'blocked')]"/>
          <filter string="Important" name="important" domain="[('priority', '=', '1')]"/>
          <filter string="Private To-dos" name="private" domain="[('project_id', '=', False)]"/>
          <group>
            <filter string="Project" name="group_by_project_id" domain="[]" context="{'group_by': 'project_id'}"/>
            <filter string="Stage" name="group_by_stage_id" domain="[]" context="{'group_by': 'stage_id'}"/>
            <filter string="Kanban State" name="group_by_kanban_state" domain="[]" context="{'group_by': 'kanban_state'}"/>
            <filter string="Priority" name="group_by_priority" domain="[]" context="{'group_by': 'priority'}"/>
            <filter string="Milestone" name="group_by_milestone_id" domain="[]" context="{'group_by': 'milestone_id'}"/>
          </group>
        </search>
      </field>
    </record>
    <record id="view_project_task_kanban" model="ui.view">
      <field name="name">tbl.project_task.kanban</field>
      <field name="model">tbl.project_task</field>
      <field name="type">kanban</field>
      <field name="arch" type="xml">
        <kanban default_group_by="stage_id" color="stage_color">
          <templates>
            <t t-name="card">
              <div class="o_kanban_record">
                <field name="name"/>
                <field name="priority"/>
                <field name="project_id"/>
                <field name="user_ids"/>
                <field name="tag_ids"/>
                <field name="date_deadline"/>
                <field name="kanban_state" widget="kanban_color_picker"/>
              </div>
            </t>
          </templates>
        </kanban>
      </field>
    </record>
    <record id="view_project_task_gantt" model="ui.view">
      <field name="name">tbl.project_task.gantt</field>
      <field name="model">tbl.project_task</field>
      <field name="type">gantt</field>
      <field name="arch" type="xml">
        <gantt date_start="date_start" date_stop="date_deadline" default_group_by="project_id" color="stage_color" string="Task Timeline" default_scale="week"/>
      </field>
    </record>
    <record id="view_project_task_hierarchy" model="ui.view">
      <field name="name">tbl.project_task.hierarchy</field>
      <field name="model">tbl.project_task</field>
      <field name="type">hierarchy</field>
      <field name="arch" type="xml">
        <hierarchy parent_field="parent_id" draggable="0" icon="check-square">
          <templates>
            <t t-name="card">
              <field name="name"/>
              <field name="stage_id"/>
              <field name="user_ids"/>
            </t>
          </templates>
        </hierarchy>
      </field>
    </record>
</data>
