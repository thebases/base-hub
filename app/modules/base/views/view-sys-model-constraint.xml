<?xml version="1.0" encoding="utf-8"?>
<data noupdate="1">
    <record id="view_sys_model_constraint_list" model="ui.view">
      <field name="name">sys.model.constraint.list</field>
      <field name="model">sys.model.constraint</field>
      <field name="type">list</field>
      <field name="arch" type="xml">
        <list string="Model Constraints" decoration-danger="state == 'error'" decoration-muted="state == 'disabled'">
          <field name="name"/>
          <field name="model_name"/>
          <field name="constraint_type"/>
          <field name="state"/>
          <field name="last_applied_at"/>
        </list>
      </field>
    </record>
    <record id="view_sys_model_constraint_form" model="ui.view">
      <field name="name">sys.model.constraint.form</field>
      <field name="model">sys.model.constraint</field>
      <field name="type">form</field>
      <field name="arch" type="xml">
        <form string="Model Constraint">
          <header>
            <button string="Apply" type="object" name="action_apply" class="btn-primary" icon="fa-check" invisible="state == 'disabled'"/>
            <button string="Enable" type="object" name="action_enable" class="btn-secondary" icon="fa-play" invisible="state != 'disabled'"/>
            <button string="Disable" type="object" name="action_disable" class="btn-secondary" icon="fa-pause" invisible="state == 'disabled' or state == 'draft'"/>
          </header>
          <sheet>
            <group>
              <group>
                <field name="name" placeholder="e.g. unique_partner_code"/>
                <field name="model_name" widget="sys_model_name"/>
                <field name="constraint_type"/>
                <field name="state" readonly="1"/>
              </group>
              <group>
                <field name="bid" readonly="1" invisible="not bid"/>
                <field name="description"/>
                <field name="module"/>
              </group>
            </group>
            <div class="d-flex align-items-start gap-4" invisible="constraint_type == 'business_rule'">
              <main class="d-flex flex-fill flex-column gap-2">
                <p class="small text-muted">
                  SQL Definition holds only the part after the keyword — no CHECK/UNIQUE wrapper, no trailing semicolon.
                  check: a boolean expression, e.g. "price &gt; 0". unique: a comma-separated column list, e.g. "company_id, code".
                  unique_index: the parenthesized column/expression clause exactly as it follows CREATE UNIQUE INDEX name ON table,
                  e.g. "(email) WHERE active" or "(company_id, code)". Message is what the caller sees instead of the raw
                  PostgreSQL error when this constraint is violated, e.g. "The code must be unique per company."
                </p>
              </main>
            </div>
            <group invisible="constraint_type == 'business_rule'">
              <field name="sql_definition" placeholder="company_id, code"/>
              <field name="message" placeholder="The code must be unique per company."/>
            </group>
            <div class="d-flex align-items-start gap-4" invisible="constraint_type != 'business_rule'">
              <main class="d-flex flex-fill flex-column gap-2">
                <p class="small text-muted">
                  Invalid Domain is an domain (e.g. [["amount", "&lt;", 0]]) that matches the records this rule
                  rejects. Trigger Fields lists which changed fields re-evaluate the domain on write — leave a field out and
                  edits to it never trigger this rule. Message is shown to the caller when a write matches the domain.
                </p>
              </main>
            </div>
            <group invisible="constraint_type != 'business_rule'">
              <field name="invalid_domain" placeholder='[["amount", "&lt;", 0]]'/>
              <field name="trigger_fields" placeholder='["amount"]'/>
              <field name="message" placeholder="Amount must not be negative."/>
            </group>
            <group string="Reconciliation">
              <field name="last_applied_at" readonly="1"/>
              <field name="last_error" readonly="1"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>
    <record id="view_sys_model_constraint_search" model="ui.view">
      <field name="name">sys.model.constraint.search</field>
      <field name="model">sys.model.constraint</field>
      <field name="type">search</field>
      <field name="arch" type="xml">
        <search string="Model Constraints">
          <field name="name"/>
          <field name="model_name"/>
          <field name="constraint_type"/>
          <field name="state"/>
          <group>
            <filter string="Model" name="group_by_model_name" domain="[]" context="{'group_by': 'model_name'}"/>
            <filter string="Constraint Type" name="group_by_constraint_type" domain="[]" context="{'group_by': 'constraint_type'}"/>
            <filter string="State" name="group_by_state" domain="[]" context="{'group_by': 'state'}"/>
          </group>
        </search>
      </field>
    </record>
</data>
