<?xml version="1.0" encoding="utf-8"?>
<data noupdate="1">
    <record id="view_sys_model_data_list" model="ui.view">
      <field name="name">sys.model.data.list</field>
      <field name="model">sys.model.data</field>
      <field name="type">list</field>
      <field name="arch" type="xml">
        <list string="External Identifiers">
          <field name="complete_name"/>
          <field name="model"/>
          <field name="module"/>
          <field name="model_id"/>
          <field name="noupdate"/>
        </list>
      </field>
    </record>
    <record id="view_sys_model_data_form" model="ui.view">
      <field name="name">sys.model.data.form</field>
      <field name="model">sys.model.data</field>
      <field name="type">form</field>
      <field name="arch" type="xml">
        <form string="External Identifier">
          <sheet>
            <group>
              <group>
                <field name="name"/>
                <field name="complete_name"/>
                <field name="module"/>
                <field name="model"/>
              </group>
              <group>
                <field name="model_id"/>
                <field name="reference"/>
                <field name="noupdate"/>
              </group>
            </group>
          </sheet>
        </form>
      </field>
    </record>
    <record id="view_sys_model_data_search" model="ui.view">
      <field name="name">sys.model.data.search</field>
      <field name="model">sys.model.data</field>
      <field name="type">search</field>
      <field name="arch" type="xml">
        <search string="External Identifiers">
          <field name="complete_name"/>
          <field name="model"/>
          <field name="module"/>
          <field name="reference"/>
          <group>
            <filter string="Module" name="group_by_module" domain="[]" context="{'group_by': 'module'}"/>
            <filter string="Model" name="group_by_model" domain="[]" context="{'group_by': 'model'}"/>
          </group>
        </search>
      </field>
    </record>
</data>
