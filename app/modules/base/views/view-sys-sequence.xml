<?xml version="1.0" encoding="utf-8"?>
<data noupdate="1">
    <record id="view_sys_sequence_list" model="ui.view">
      <field name="name">sys.sequence.list</field>
      <field name="model">sys.sequence</field>
      <field name="type">list</field>
      <field name="arch" type="xml">
        <list string="Sequences" sample="1" multi_edit="1">
          <field name="name"/>
          <field name="active"/>
          <field name="code"/>
          <field name="implementation" optional="show"/>
          <field name="number_next" optional="show"/>
          <field name="prefix" optional="hide"/>
          <field name="suffix" optional="hide"/>
          <field name="company_id" optional="hide"/>
        </list>
      </field>
    </record>
    <record id="view_sys_sequence_form" model="ui.view">
      <field name="name">sys.sequence.form</field>
      <field name="model">sys.sequence</field>
      <field name="type">form</field>
      <field name="arch" type="xml">
        <form string="Sequence">
          <widget name="web_ribbon" title="Archived" bg_color="bg-red-100 text-red-700" invisible="active"/>
          <sheet>
            <div class="d-flex align-items-start gap-4">
              <main class="d-flex flex-fill flex-column gap-2">
                <h1>
                  <field name="name" nolabel="1"/>
                </h1>
              </main>
            </div>
            <group>
              <group string="General">
                <field name="active"/>
                <field name="code"/>
                <field name="implementation"/>
                <field name="company_id"/>
              </group>
              <group string="Formatting">
                <field name="prefix" placeholder="INV/%(year)s/"/>
                <field name="suffix"/>
                <field name="padding"/>
                <field name="increment"/>
                <field name="number_next"/>
              </group>
            </group>
            <notebook>
              <page string="Audit" name="audit">
                <field name="created_at"/>
                <field name="updated_at"/>
              </page>
            </notebook>
          </sheet>
        </form>
      </field>
    </record>
    <record id="view_sys_sequence_search" model="ui.view">
      <field name="name">sys.sequence.search</field>
      <field name="model">sys.sequence</field>
      <field name="type">search</field>
      <field name="arch" type="xml">
        <search string="Sequences">
          <field name="name"/>
          <field name="code"/>
          <field name="implementation"/>
          <filter string="Is Active" name="active_true" domain="[('active', '=', True)]"/>
          <filter string="Not Is Active" name="active_false" domain="[('active', '=', False)]"/>
          <group>
            <filter string="Implementation" name="group_by_implementation" domain="[]" context="{'group_by': 'implementation'}"/>
            <filter string="Company" name="group_by_company_id" domain="[]" context="{'group_by': 'company_id'}"/>
          </group>
        </search>
      </field>
    </record>
</data>
