<?xml version="1.0" encoding="utf-8"?>
<data noupdate="1">
    <record id="view_tbl_country_ward_list" model="ui.view">
      <field name="name">tbl.country.ward.list</field>
      <field name="model">tbl.country.ward</field>
      <field name="type">list</field>
      <field name="arch" type="xml">
        <list string="Country Ward" sample="1" multi_edit="1">
          <field name="name"/>
          <field name="code"/>
          <field name="country_id"/>
          <field name="state_id" optional="show"/>
          <field name="created_at" optional="show"/>
          <field name="updated_at" optional="hide"/>
        </list>
      </field>
    </record>
    <record id="view_tbl_country_ward_form" model="ui.view">
      <field name="name">tbl.country.ward.form</field>
      <field name="model">tbl.country.ward</field>
      <field name="type">form</field>
      <field name="arch" type="xml">
        <form string="Country Ward">
          <sheet>
            <div class="d-flex align-items-start gap-4">
              <main class="d-flex flex-fill flex-column gap-2">
                <h1>
                  <field name="name" nolabel="1"/>
                </h1>
                <div class="d-inline-flex flex-wrap align-items-center gap-2 small text-muted">
                  <field name="code" nolabel="1"/>
                </div>
              </main>
            </div>
            <group string="Address">
              <div class="d-flex flex-column gap-2">
                <field name="state_id"/>
                <field name="country_id"/>
              </div>
            </group>
            <notebook>
              <page string="Audit" name="audit">
                <field name="created_at"/>
                <field name="updated_at"/>
              </page>
            </notebook>
          </sheet>
        </form>
      </field>
    </record>
    <record id="view_tbl_country_ward_search" model="ui.view">
      <field name="name">tbl.country.ward.search</field>
      <field name="model">tbl.country.ward</field>
      <field name="type">search</field>
      <field name="arch" type="xml">
        <search string="Country Ward">
          <field name="name"/>
          <field name="code"/>
          <field name="country_id"/>
          <field name="state_id"/>
          <field name="created_at"/>
          <group>
            <filter string="Country ID" name="group_by_country_id" domain="[]" context="{'group_by': 'country_id'}"/>
            <filter string="State ID" name="group_by_state_id" domain="[]" context="{'group_by': 'state_id'}"/>
          </group>
        </search>
      </field>
    </record>
</data>
