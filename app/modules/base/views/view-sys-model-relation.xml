<?xml version="1.0" encoding="utf-8"?>
<data noupdate="1">
    <record id="view_sys_model_relation_list" model="ui.view">
      <field name="name">sys.model.relation.list</field>
      <field name="model">sys.model.relation</field>
      <field name="type">list</field>
      <field name="arch" type="xml">
        <list string="Model Relations">
          <field name="name"/>
          <field name="model_name"/>
          <field name="field_name"/>
          <field name="relation_model"/>
          <field name="relation_table"/>
        </list>
      </field>
    </record>
    <record id="view_sys_model_relation_form" model="ui.view">
      <field name="name">sys.model.relation.form</field>
      <field name="model">sys.model.relation</field>
      <field name="type">form</field>
      <field name="arch" type="xml">
        <form string="Model Relation">
          <sheet>
            <group>
              <group>
                <field name="name" readonly="not bid"/>
                <field name="bid"/>
                <field name="module" readonly="not bid"/>
                <field name="model_name" readonly="not bid"/>
                <field name="field_name" readonly="not bid"/>
              </group>
              <group>
                <field name="relation_model" readonly="not bid"/>
                <field name="relation_table" readonly="not bid"/>
                <field name="relation_column" readonly="not bid"/>
                <field name="relation_key" readonly="not bid"/>
              </group>
            </group>
          </sheet>
        </form>
      </field>
    </record>
    <record id="view_sys_model_relation_search" model="ui.view">
      <field name="name">sys.model.relation.search</field>
      <field name="model">sys.model.relation</field>
      <field name="type">search</field>
      <field name="arch" type="xml">
        <search string="Model Relations">
          <field name="name"/>
          <field name="model_name"/>
          <field name="relation_model"/>
          <field name="module"/>
          <group>
            <filter string="Module" name="group_by_module" domain="[]" context="{'group_by': 'module'}"/>
            <filter string="Model" name="group_by_model_name" domain="[]" context="{'group_by': 'model_name'}"/>
          </group>
        </search>
      </field>
    </record>
</data>
